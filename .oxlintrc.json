{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxlint/schema.json",
  "ignorePatterns": [
    "node_modules/**",
    ".vitepress/dist/**",
    ".vitepress/cache/**",
    "playwright-report/**",
    "test-results/**"
  ],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.vue"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}
