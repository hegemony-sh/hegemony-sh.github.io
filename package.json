{
  "name": "hegemony-site",
  "version": "1.0.0",
  "private": true,
  "description": "Project website for Hegemony — a proof-of-execution platform for deterministic, long-running infrastructure workflows on Temporal.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "audit": "npm audit --audit-level=moderate",
    "linkcheck:internal": "node scripts/check-internal-links.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .vitepress playwright.config.ts e2e scripts",
    "lint:fix": "oxlint .vitepress playwright.config.ts e2e scripts --fix",
    "lint:css": "stylelint '.vitepress/theme/**/*.css'",
    "lint:css:fix": "stylelint '.vitepress/theme/**/*.css' --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test -g @smoke --project=chromium",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "verify": "npm run format:check && npm run lint && npm run lint:css && npm run lint:md && npm run typecheck && npm run typecheck:e2e && npm run docs:build && npm run linkcheck:internal"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^22.19.19",
    "markdownlint-cli2": "^0.23.0",
    "oxfmt": "0.24.0",
    "oxlint": "0.16.6",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.3",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.3"
  },
  "overrides": {
    "esbuild": "0.25.0",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
